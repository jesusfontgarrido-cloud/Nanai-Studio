---
/**
 * La idea. Una sola sección con más peso: el retrato grande de Jesús a un lado y, al otro,
 * la idea del estudio firmada por él, que es quien la tuvo, con su bio y sus redes.
 *
 * «full» (Sobre nosotros) cambia la idea por «¿Quién hay detrás de Nanai?» y la bio de Jesús
 * (la idea ya está en la home; repetirla aquí sobraba).
 * Va sin cápsula: respira directo sobre el negro.
 */
import { Picture } from 'astro:assets';
import portrait from '../../assets/media/jesus-font-4x5.jpg';
import FlatEm from './FlatEm.astro';
import { idea, manifesto, studio } from '../../data/copy';
import { site } from '../../data/site';

interface Props {
  num?: string;
  variant?: 'teaser' | 'full';
}

const { num = '03', variant = 'teaser' } = Astro.props;
const full = variant === 'full';
---

<section class="sec" aria-labelledby="manifesto-title">
  <div class="wrap fmanifesto">
    <div class:list={['fmanifesto__grid', { 'fmanifesto__grid--teaser': !full }]}>
      <figure class="fmanifesto__portrait bw" data-reveal="focus">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 38vw, 100vw"
          alt="Jesús Font con una cámara de cine"
          loading="lazy"
        />
      </figure>

      {
        full ? (
          <div class="fmanifesto__text">
            <h2 id="manifesto-title" class="h2 fmanifesto__quote" data-reveal="lines">
              <span><FlatEm text={studio.who} /></span>
            </h2>
            <div class="fmanifesto__bio" data-reveal style="--i: 2">
              {studio.bio.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {/* Las redes personales de Jesús: solo aquí, en toda la web */}
            <div class="fmanifesto__sign fmanifesto__card" data-reveal style="--i: 3">
              <div>
                <p class="fmanifesto__name">{manifesto.signature}</p>
                <p class="label">{manifesto.role}</p>
              </div>
              <ul class="fmanifesto__social" role="list" aria-label="Redes de Jesús Font">
                <li>
                  <a href={site.jesus.instagram} target="_blank" rel="noopener me">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
                    <span>Instagram<span class="fmanifesto__handle">{site.jesus.instagramHandle}</span></span>
                  </a>
                </li>
                <li>
                  <a href={site.jesus.linkedin} target="_blank" rel="noopener me">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4v11H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.83-2 3.77-2 4.03 0 4.77 2.6 4.77 6v5.4h-4v-4.8c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.88h-4z" /></svg>
                    <span>LinkedIn<span class="fmanifesto__handle">Jesús Font Garrido</span></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        ) : (
          <div class="fmanifesto__text">
            <p class="label" data-reveal>{manifesto.label}</p>
            <h2 id="manifesto-title" class="h2 fmanifesto__quote" data-reveal="lines">
              <span><FlatEm text={idea.lines[0]} /></span>
              <span class="fmanifesto__quote-2">{idea.lines[1]}</span>
            </h2>

            {idea.paragraphs.map((paragraph) => <p class="lead fmanifesto__idea" data-reveal style="--i: 2">{paragraph}</p>)}

            <div class="fmanifesto__sign" data-reveal style="--i: 3">
              <p class="fmanifesto__name">{manifesto.signature}</p>
              <p class="label">{manifesto.role}</p>
            </div>

            <a class="link" href="/sobre-nosotros" data-reveal style="--i: 4">Sobre nosotros →</a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .fmanifesto__grid {
    display: grid;
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .fmanifesto__portrait {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--f-r-media);
    background: var(--f-surface-2);
    color: #121110;
  }

  .fmanifesto__portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .fmanifesto__caption {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: rgba(18, 17, 16, 0.78);
  }

  .fmanifesto__caption :global(.readout__key) { color: rgba(18, 17, 16, 0.55); }

  .fmanifesto__text {
    display: grid;
    gap: 22px;
  }

  /* La idea, como cita grande */
  .fmanifesto__quote { font-size: clamp(34px, 4.2vw, 68px); }

  .fmanifesto__quote > span { display: block; }
  .fmanifesto__quote-2 { color: var(--f-dim); }

  .fmanifesto__idea { max-width: 48ch; }

  /* Firma */
  .fmanifesto__sign {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-block: var(--f-hair) solid var(--f-line);
  }

  /* La firma: el nombre en la letra de la marca */
  .fmanifesto__name {
    font-family: var(--font-display);
    font-size: clamp(24px, 2vw, 30px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .fmanifesto__bio {
    display: grid;
    gap: 14px;
    max-width: 60ch;
    color: var(--f-muted);
  }

  .fmanifesto__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  /* Tarjeta de firma con las redes de Jesús */
  .fmanifesto__card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }

  .fmanifesto__social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fmanifesto__social a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 16px 8px 12px;
    border: var(--f-hair) solid var(--f-line-strong);
    border-radius: var(--f-r);
    color: var(--f-on-surface);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    transition: background-color var(--f-dur) var(--f-ease), color var(--f-dur) var(--f-ease), border-color var(--f-dur) var(--f-ease);
  }

  .fmanifesto__social a > span { display: grid; }

  .fmanifesto__social svg { width: 20px; height: 20px; flex: none; }

  .fmanifesto__handle {
    font-family: var(--font-type);
    font-size: 13px;
    font-weight: 400;
    color: var(--f-muted);
  }

  .fmanifesto__social a:hover {
    border-color: var(--f-inverse);
    background: var(--f-inverse);
    color: var(--f-on-inverse);
  }

  .fmanifesto__social a:hover .fmanifesto__handle { color: inherit; opacity: 0.75; }

  @media (min-width: 1024px) {
    .fmanifesto__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); column-gap: clamp(40px, 6vw, 112px); }
    .fmanifesto__grid--teaser { align-items: center; }
    .fmanifesto__portrait { position: sticky; top: 110px; }
  }
</style>
