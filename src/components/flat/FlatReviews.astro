---
/**
 * Reseñas de Google, pintadas por la web con los datos de la API de Featurable (decisión del
 * usuario, 21-10-2026). Antes era su widget: un carrusel de terceros en un shadow DOM que
 * pesaba, no casaba con la piel y en móvil ensanchaba la página.
 *
 * Se leen al construir la web (salen en el HTML: rápido y visible para Google). Si la API no
 * responde al construir, se usa la última copia guardada (src/data/reviews-snapshot.json).
 * En el navegador se vuelve a preguntar a la API y, si hay reseñas nuevas, se repinta: así no
 * hace falta volver a publicar cada vez que llega una.
 *
 * Solo reseñas reales, con su texto original y sin retocar.
 */
import snapshot from '../../data/reviews-snapshot.json';

const API = 'https://api.featurable.com/v2/widgets/437dee1d-ba24-4335-ae8e-3197ec6162b7';

interface Review {
  id: string;
  author: { name: string };
  text: string;
  originalText?: string | null;
  rating: { value: number };
  publishedAt: string;
}

type Widget = typeof snapshot.widget;

let widget: Widget = snapshot.widget;
try {
  const response = await fetch(API, { signal: AbortSignal.timeout(6000) });
  const data = await response.json();
  if (data?.success && data.widget?.reviews?.length) widget = data.widget;
} catch {
  // Sin conexión al construir: se queda la copia guardada.
}

const reviews = (widget.reviews as Review[])
  .filter((review) => (review.originalText ?? review.text)?.trim())
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const summary = widget.gbpLocationSummary;
const rating = summary.rating.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const month = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<section class="sec freviews" aria-labelledby="reviews-title" data-reviews-api={API}>
  <div class="wrap freviews__grid">
    <div class="freviews__head">
      <h2 id="reviews-title" class="h2" data-reveal="lines"><span>Lo que dicen de nosotros</span></h2>

      <div class="freviews__score" data-reveal style="--i: 2">
        <p class="freviews__rating">{rating}</p>
        <div>
          <p class="freviews__stars" aria-hidden="true">★★★★★</p>
          <p class="label" data-reviews-count>
            {summary.reviewsCount} reseñas en Google
          </p>
        </div>
      </div>
      <p class="visually-hidden">Valoración media de {rating} sobre 5 en Google, con {summary.reviewsCount} reseñas.</p>

      {
        summary.writeAReviewUri && (
          <a class="link freviews__write" href={summary.writeAReviewUri} target="_blank" rel="noopener" data-reveal style="--i: 3">
            ¿Has trabajado con nosotros? Déjanos tu reseña →
          </a>
        )
      }
    </div>

    <div class="freviews__carousel" data-reveal style="--i: 2">
    <ul class="freviews__list" role="list" tabindex="0" aria-label="Reseñas: desliza para ver más" data-reviews-list>
      {
        reviews.map((review) => (
          <li class="freview">
            <p class="freview__stars" aria-label={`${review.rating.value} de 5 estrellas`}>
              {'★'.repeat(review.rating.value)}
            </p>
            <blockquote class="freview__text">
              <p>{(review.originalText ?? review.text).trim()}</p>
            </blockquote>
            <p class="freview__author">
              <span class="freview__avatar" aria-hidden="true">{initials(review.author.name)}</span>
              <span>
                <span class="freview__name">{review.author.name}</span>
                <span class="label">Google · {month(review.publishedAt)}</span>
              </span>
            </p>
          </li>
        ))
      }
    </ul>

    <div class="freviews__nav">
      <button class="freviews__btn" type="button" aria-label="Reseña anterior" data-reviews-prev>←</button>
      <button class="freviews__btn" type="button" aria-label="Reseña siguiente" data-reviews-next>→</button>
    </div>
    </div>

    <p class="label freviews__credit">Reseñas de Google a través de Featurable</p>
  </div>
</section>

<script>
  // Repinta si la API trae reseñas nuevas (texto con textContent: nada de HTML ajeno).
  const section = document.querySelector<HTMLElement>('[data-reviews-api]');
  const list = section?.querySelector<HTMLElement>('[data-reviews-list]');
  const count = section?.querySelector<HTMLElement>('[data-reviews-count]');

  type ApiReview = {
    author: { name: string };
    text: string;
    originalText?: string | null;
    rating: { value: number };
    publishedAt: string;
  };

  const initials = (name: string) =>
    name.split(/\s+/).slice(0, 2).map((part) => part[0]?.toUpperCase() ?? '').join('');

  const el = (tag: string, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const card = (review: ApiReview) => {
    const item = el('li', 'freview is-in');
    const stars = el('p', 'freview__stars', '★'.repeat(review.rating.value));
    stars.setAttribute('aria-label', `${review.rating.value} de 5 estrellas`);
    const quote = el('blockquote', 'freview__text');
    quote.append(el('p', undefined, (review.originalText ?? review.text).trim()));
    const author = el('p', 'freview__author');
    const avatar = el('span', 'freview__avatar', initials(review.author.name));
    avatar.setAttribute('aria-hidden', 'true');
    const who = el('span');
    const date = new Date(review.publishedAt).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
    who.append(el('span', 'freview__name', review.author.name), el('span', 'label', `Google · ${date}`));
    author.append(avatar, who);
    item.append(stars, quote, author);
    return item;
  };

  // Carrusel: las flechas avanzan una tarjeta; con el dedo o el trackpad se desliza solo.
  const prev = section?.querySelector<HTMLButtonElement>('[data-reviews-prev]');
  const next = section?.querySelector<HTMLButtonElement>('[data-reviews-next]');
  const step = () => (list?.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 320;
  const sync = () => {
    if (!list || !prev || !next) return;
    prev.disabled = list.scrollLeft <= 4;
    next.disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 4;
  };
  prev?.addEventListener('click', () => list?.scrollBy({ left: -step(), behavior: 'smooth' }));
  next?.addEventListener('click', () => list?.scrollBy({ left: step(), behavior: 'smooth' }));
  list?.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync);
  sync();

  if (section && list) {
    const refresh = async () => {
      try {
        const response = await fetch(section.dataset.reviewsApi as string);
        const data = await response.json();
        const reviews: ApiReview[] = (data?.widget?.reviews ?? [])
          .filter((review: ApiReview) => (review.originalText ?? review.text)?.trim())
          .sort((a: ApiReview, b: ApiReview) => b.publishedAt.localeCompare(a.publishedAt));
        if (!reviews.length || reviews.length === list.children.length) return;
        list.replaceChildren(...reviews.map(card));
        sync();
        const total = data.widget.gbpLocationSummary?.reviewsCount;
        if (count && total) count.textContent = `${total} reseñas en Google`;
      } catch {
        // Si la API no responde, se quedan las del HTML.
      }
    };

    // Se pregunta cuando la sección se acerca, no al cargar la página.
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          refresh();
        },
        { rootMargin: '600px 0px' },
      );
      observer.observe(section);
    }
  }
</script>

<!-- Global: las tarjetas que se repintan desde el navegador no llevan la marca de Astro -->
<style is:global>
  .freviews__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
  }

  .freviews__head {
    display: grid;
    align-content: start;
    gap: 22px;
  }

  /* La nota, en grande: el dato habla solo */
  .freviews__score {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .freviews__rating {
    font-family: var(--font-display);
    font-size: clamp(64px, 7vw, 112px);
    font-weight: 620;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .freviews__stars {
    color: var(--f-red);
    font-size: 22px;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .freviews__score .label { color: var(--f-muted); }
  .freviews__write { justify-self: start; }

  /* Carrusel horizontal con imán: cada tarjeta encaja al soltar */
  .freviews__carousel { display: grid; gap: 18px; min-width: 0; }

  .freviews__list {
    display: flex;
    gap: var(--f-gap);
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .freviews__list::-webkit-scrollbar { display: none; }
  .freviews__list:focus-visible { outline: 2px solid var(--f-red); outline-offset: 4px; }

  .freviews__list > .freview {
    flex: 0 0 min(86%, 420px);
    scroll-snap-align: start;
  }

  .freviews__nav { display: flex; gap: 10px; }

  .freviews__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: var(--f-hair) solid var(--f-line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--f-on-surface);
    font-size: 20px;
    cursor: pointer;
    transition: background-color var(--f-dur) var(--f-ease), color var(--f-dur) var(--f-ease), opacity var(--f-dur) var(--f-ease);
  }

  .freviews__btn:hover:not(:disabled) { background: var(--f-inverse); color: var(--f-on-inverse); }
  .freviews__btn:disabled { opacity: 0.3; cursor: default; }

  .freview {
    display: grid;
    align-content: space-between;
    gap: 18px;
    padding: clamp(22px, 2.2vw, 30px);
    border: var(--f-hair) solid var(--f-line);
    border-radius: var(--f-r-media);
    background: var(--f-surface-2);
  }

  .freview__stars {
    color: var(--f-red);
    font-size: 16px;
    letter-spacing: 0.08em;
  }

  .freview__text { margin: 0; }

  .freview__text p {
    font-family: var(--font-display);
    font-size: clamp(19px, 1.5vw, 23px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap-style: pretty;
  }

  .freview__text p::before { content: '«'; }
  .freview__text p::after { content: '»'; }

  .freview__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .freview__author > span:last-child { display: grid; gap: 2px; }

  .freview__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--f-inverse);
    color: var(--f-on-inverse);
    font-size: 14px;
    font-weight: 600;
  }

  .freview__name { font-weight: 600; text-transform: capitalize; }
  .freview__author .label { color: var(--f-muted); }

  .freviews__credit {
    color: var(--f-dim);
    font-size: 12px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .freviews__list > .freview { flex-basis: calc((100% - var(--f-gap)) / 2); }
  }

  /* Escritorio: la nota a la izquierda, las reseñas a la derecha */
  @media (min-width: 1024px) {
    .freviews__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: clamp(40px, 5vw, 96px); }
    .freviews__credit { grid-column: 2; }
  }
</style>
