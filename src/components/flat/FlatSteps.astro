---
/**
 * Proceso (16-11-2026), en vertical como «Dónde he trabajado» del CV: una fila por paso, con
 * su número, su nombre grande y su explicación. Una raya une los pasos por la izquierda y se
 * llena de rojo hasta el último encendido: cada paso se enciende (casilla de rodaje marcada)
 * al llegar a la mitad de la pantalla y se queda encendido. Las filas entran en 3D (flat-fx.ts).
 * Sin JS o con movimiento reducido, todo encendido y quieto.
 */
import { process, processHead } from '../../data/copy';
---

<section id="proceso" class="sec fsteps-sec" aria-labelledby="steps-title">
  <div class="wrap fsteps">
    <div class="fsteps__head">
      <p class="label" data-reveal>{processHead.label}</p>
      <h2 id="steps-title" class="h2 fsteps__title" data-reveal="lines"><span>{processHead.title}</span></h2>
      <p class="fsteps__deck" data-reveal style="--i: 2">{processHead.deck}</p>
    </div>

    <ol class="fsteps__list" role="list" data-steps>
      {
        process.map((step, i) => (
          <li class:list={['fstep', { 'fstep--key': step.key }]} data-row>
            <div class="fstep__mark">
              <span class="fstep__node" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>
              <span class="label fstep__num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="fstep__name">{step.name}</h3>
            <p class="fstep__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-steps]').forEach((list) => {
      const steps = [...list.querySelectorAll<HTMLElement>('.fstep')];
      let reached = -1;

      // La raya roja baja hasta el centro del último nodo encendido
      // Se mide con la maquetación (offsetTop), no con lo que se ve: las filas entran girando en
      // 3D y medir en pantalla hacía que la raya diera saltos
      const measure = () => {
        const node = steps[reached]?.querySelector<HTMLElement>('.fstep__node');
        if (!node) return;
        let y = node.offsetHeight / 2;
        let el: HTMLElement | null = node;
        while (el && el !== list) {
          y += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        list.style.setProperty('--reach-y', `${y}px`);
      };

      // Solo avanza: lo que se ha encendido, se queda encendido
      const light = (upTo: number) => {
        if (upTo <= reached) return;
        reached = upTo;
        steps.forEach((step, i) => step.classList.toggle('is-done', i <= reached));
        measure();
      };

      list.classList.add('is-armed');
      addEventListener('resize', measure);

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && light(steps.indexOf(e.target as HTMLElement))),
        { rootMargin: '0px 0px -45% 0px' },
      );
      steps.forEach((step) => io.observe(step));
    });
  }
</script>

<style>
  .fsteps-sec { padding-block: var(--f-sec); }

  .fsteps {
    display: grid;
    gap: clamp(36px, 5vw, 64px);
  }

  .fsteps__head { display: grid; gap: 14px; max-width: 60ch; }
  .fsteps__deck { max-width: 52ch; color: var(--f-muted); }

  .fsteps__list {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    perspective: 1200px;
  }

  /* La raya que une los pasos, a la altura de los nodos */
  .fsteps__list::before,
  .fsteps__list::after {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    left: 13px;
    width: 1px;
    pointer-events: none;
  }

  .fsteps__list::before { bottom: 0; background: var(--f-line-strong); }

  .fsteps__list::after {
    height: var(--reach-y, 0px);
    background: var(--f-red);
    transition: height 520ms var(--f-ease-out);
  }

  .fsteps__list:not(.is-armed)::after { display: none; }

  /* Cada fila va por encima de la raya: los nodos la tapan (las filas son capas propias por el 3D) */
  .fstep {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(120px, 0.5fr) minmax(0, 1.2fr) minmax(0, 1.3fr);
    align-items: baseline;
    gap: 10px var(--f-gap);
    padding-block: clamp(26px, 3.2vw, 44px);
    border-top: 1px solid var(--f-line-strong);
    transform-style: preserve-3d;
  }

  .fstep:last-child { border-bottom: 1px solid var(--f-line-strong); }

  .fstep__mark { display: flex; align-items: center; gap: 16px; }

  /* Los nodos van por encima de la raya */
  .fstep__node {
    position: relative;
    z-index: 1;
    display: grid;
    flex: none;
    place-items: center;
    width: 27px;
    height: 27px;
    border-radius: var(--f-r);
    background: var(--f-on-surface);
    color: var(--f-bg);
    transition: transform var(--f-dur) var(--f-ease), background-color 320ms var(--f-ease);
  }

  .fstep--key .fstep__node { background: var(--f-red); color: #fff; }

  .fstep__node svg {
    width: 15px;
    height: 15px;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--f-dur) var(--f-ease), transform var(--f-dur) var(--f-ease);
  }

  .fstep.is-done .fstep__node { transform: scale(1.1); }
  .fstep.is-done .fstep__node svg { opacity: 1; transform: scale(1); }

  .fstep__num { color: var(--f-muted); }

  .fstep__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.6vw, 60px);
    font-weight: 640;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .fstep__text {
    max-width: 44ch;
    margin: 0;
    color: var(--f-muted);
    font-size: 17px;
    line-height: 1.5;
  }

  /* Apagado: nodo gris y texto atenuado hasta que el paso se enciende */
  .fstep__name,
  .fstep__text,
  .fstep__num { transition: opacity 420ms var(--f-ease), color 320ms var(--f-ease); }

  .fsteps__list.is-armed .fstep:not(.is-done) .fstep__node {
    background: var(--f-surface-3);
    box-shadow: inset 0 0 0 1px var(--f-line-strong);
  }

  .fsteps__list.is-armed .fstep:not(.is-done) .fstep__name,
  .fsteps__list.is-armed .fstep:not(.is-done) .fstep__text,
  .fsteps__list.is-armed .fstep:not(.is-done) .fstep__num { opacity: 0.32; }

  @media (max-width: 899px) {
    .fstep {
      grid-template-columns: 1fr;
      padding-left: 46px;
    }

    .fstep__mark { position: absolute; top: clamp(26px, 3.2vw, 44px); left: 0; }
    .fstep__num { display: none; }
    .fstep__name { font-size: clamp(28px, 8vw, 40px); }
  }
</style>
