---
/**
 * Cabecera de las páginas interiores. Sin caja: el titular va suelto sobre el papel, en
 * una línea en escritorio («Trabajos del estudio», «Quiénes somos»), con la entradilla
 * debajo. Sin etiqueta encima: repetiría el nombre de la página, que ya está en el menú y
 * en el titular (la etiqueta se queda como nombre de la sección para los lectores de
 * pantalla). Puede llevar una foto a lo ancho (Sobre nosotros: el equipo).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import FlatSlideCta from './FlatSlideCta.astro';
import FlatEm from './FlatEm.astro';

interface Props {
  num: string;
  /** Nombre de la sección para los lectores de pantalla (no se muestra). */
  label: string;
  /** Titular en dos partes, en la misma línea: la segunda va en gris. Admite *cursiva*. */
  title: [string, string];
  deck?: string | string[];
  cta?: { href: string; label: string };
  readout?: string;
  /** Foto a lo ancho bajo el titular. */
  image?: { src: ImageMetadata; alt: string; credit?: string };
}

const { label, title, deck, cta, image } = Astro.props;
const decks = deck ? (Array.isArray(deck) ? deck : [deck]) : [];
---

<section class="sec fpage-sec" aria-label={label}>
  <div class="wrap fpage">
    <h1 class="display fpage__title" data-reveal="lines">
      <span><FlatEm text={title[0]} /> <span class="fpage__title-2"><FlatEm text={title[1]} /></span></span>
    </h1>

    {
      decks.length > 0 && (
        <div class="fpage__deck" data-reveal style="--i: 3">
          {decks.map((paragraph) => (
            <p class="lead">{paragraph}</p>
          ))}
        </div>
      )
    }

    {
      cta && (
        <div class="fpage__actions" data-reveal style="--i: 4">
          <FlatSlideCta href={cta.href} label={cta.label} />
        </div>
      )
    }

    {
      image && (
        <figure class="fpage__photo" data-reveal="focus">
          <Picture src={image.src} formats={['avif', 'webp']} widths={[800, 1280, 1920, 2400]} sizes="100vw" alt={image.alt} loading="eager" />
          {image.credit && <span class="photo-credit">Foto {image.credit}</span>}
        </figure>
      )
    }
  </div>
</section>

<style>
  .fpage-sec {
    padding-top: clamp(120px, 18vh, 200px);
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  .fpage { display: grid; gap: 18px; }

  .fpage__title { font-size: clamp(48px, 9.4vw, 176px); }

  .fpage__photo {
    position: relative;
    margin: clamp(24px, 3vw, 48px) 0 0;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    border-radius: var(--f-r-card);
    background: var(--f-surface-3);
  }

  .fpage__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 699px) {
    .fpage__photo { aspect-ratio: 4 / 3; }
  }

  /* En móvil, siempre en dos líneas: así no cambia de alto al llegar la tipografía */
  @media (max-width: 699px) {
    .fpage__title-2 { display: block; }
  }

  .fpage__deck {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    margin-top: clamp(8px, 1.2vw, 16px);
    color: var(--f-muted);
  }

  .fpage__actions { margin-top: 32px; }
</style>
