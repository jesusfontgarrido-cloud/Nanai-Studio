---
/**
 * Botón de deslizar: píldora en hueso con el círculo de la flecha a la izquierda.
 * Al pulsar, el círculo recorre la píldora y después navega (o baja al ancla).
 * Sin JS es un enlace normal; con movimiento reducido navega sin animación.
 * En reposo el círculo va en --ink para que dos botones iguales no sumen dos rojos:
 * se vuelve rojo solo en el que se señala o se pulsa.
 */
import Arrow from '../ui/Arrow.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="slide-cta" href={href} data-slide-cta>
  <span class="slide-cta__knob" aria-hidden="true"><Arrow /></span>
  <span class="slide-cta__label">{label}</span>
</a>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLAnchorElement>('[data-slide-cta]').forEach((cta) => {
    const knob = cta.querySelector<HTMLElement>('.slide-cta__knob');

    cta.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (reduceMotion.matches || !knob) return;

      event.preventDefault();
      if (cta.classList.contains('is-sliding')) return;
      cta.classList.add('is-sliding');

      let done = false;
      const go = () => {
        if (done) return;
        done = true;
        const url = new URL(cta.href);
        const samePage = url.pathname === location.pathname && url.hash;
        const target = samePage ? document.querySelector(url.hash) : null;

        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, '', url.hash);
          window.setTimeout(() => cta.classList.remove('is-sliding'), 900);
        } else {
          location.assign(cta.href);
        }
      };

      knob.addEventListener('transitionend', (end) => {
        if (end.propertyName === 'transform') go();
      });
      // Por si la transición no llega a dispararse (pestaña en segundo plano).
      window.setTimeout(go, 700);
    });
  });

  // Al volver atrás desde otra página, el botón no se queda deslizado.
  window.addEventListener('pageshow', () => {
    document.querySelectorAll('[data-slide-cta].is-sliding').forEach((cta) => cta.classList.remove('is-sliding'));
  });
</script>

<style>
  .slide-cta {
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: center;
    width: min(100%, var(--slide-cta-w));
    height: var(--cta-height);
    padding: calc((var(--cta-height) - var(--cta-dot)) / 2);
    border-radius: var(--radius-pill);
    background: var(--bone);
    color: var(--text-on-bone);
    font-size: var(--fs-ui);
    font-weight: var(--weight-headline);
    text-decoration: none;
    overflow: hidden;
  }

  .slide-cta__knob {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: none;
    width: var(--cta-dot);
    height: var(--cta-dot);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--bone);
    transition:
      transform var(--dur-slide) var(--ease-standard),
      background-color var(--dur-switch) var(--ease-standard),
      color var(--dur-switch) var(--ease-standard);
  }

  .slide-cta__label {
    flex: 1;
    text-align: center;
    transition:
      opacity var(--dur-switch) var(--ease-standard),
      transform var(--dur-slide) var(--ease-standard);
  }

  .slide-cta:focus-visible .slide-cta__knob {
    background: var(--red);
    color: var(--white);
  }

  @media (hover: hover) {
    .slide-cta:hover .slide-cta__knob {
      background: var(--red);
      color: var(--white);
      transform: translateX(var(--cta-nudge));
    }
  }

  /* El círculo recorre todo el ancho útil de la píldora (100cqw = caja de contenido) */
  .slide-cta.is-sliding .slide-cta__knob {
    background: var(--red);
    color: var(--white);
    transform: translateX(calc(100cqw - var(--cta-dot)));
  }

  .slide-cta.is-sliding .slide-cta__label {
    opacity: 0;
    transform: translateX(var(--space-2));
  }
</style>
