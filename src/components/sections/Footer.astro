---
/** 11 · Pie (negro). */
import Arrow from '../ui/Arrow.astro';
import Wordmark from '../ui/Wordmark.astro';
import { site } from '../../data/site';
---

<footer class="site-footer zone-night">
  <div class="container site-footer__inner">
    <ul class="label site-footer__data" role="list">
      <li>Productora audiovisual creativa</li>
      <li>Sevilla, España</li>
      <li>{site.coordinates}</li>
    </ul>

    <div class="site-footer__links">
      <nav aria-label="Páginas">
        <ul role="list">
          <li><a class="text-link" href="/marcas">Marcas</a></li>
          <li><a class="text-link" href="/artistas">Artistas y creadores</a></li>
          <li><a class="text-link" href="/estudio">Estudio</a></li>
        </ul>
      </nav>

      <nav aria-label="Redes">
        <ul role="list">
          <li><a class="text-link" href={site.instagram}>Instagram</a></li>
          <li>
            <a class="label site-footer__weddings" href="#pendiente-weddings" data-pending="url">
              Nanai Weddings <Arrow />
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Legal">
        <ul class="label" role="list">
          <li><a href="#pendiente-aviso-legal" data-pending="page">Aviso legal</a></li>
          <li><a href="#pendiente-privacidad" data-pending="page">Política de privacidad</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="container site-footer__wordmark">
    <Wordmark text="nanai-studio" />
  </div>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    padding-top: var(--section-pad);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__data {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-block: var(--hairline) solid var(--rule);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__links ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .site-footer__weddings {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
  }

  .site-footer__wordmark { margin-top: var(--space-8); }

  @media (min-width: 768px) {
    .site-footer__data { grid-template-columns: repeat(3, 1fr); }
  }
</style>
