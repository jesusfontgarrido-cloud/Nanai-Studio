---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Ruta canónica relativa, p. ej. "/". Por defecto, la actual. */
  path?: string;
  /** Imagen para compartir (1200 × 630), ruta pública. */
  image?: string;
}

const {
  title = 'Nanai Studio | Productora audiovisual creativa en Sevilla',
  description = 'Productora audiovisual creativa en Sevilla. Dirección creativa y producción audiovisual para marcas, artistas y creadores.',
  path,
  image = '/og/nanai-studio.jpg',
} = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();
const home = new URL('/', Astro.site).toString();

// Datos estructurados: quién es el estudio, dónde está y cómo contactar. Solo datos reales.
const [lat, lng] = [37.3891, -5.9845];
const phone = '+' + site.whatsapp.replace(/\D/g, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${home}#estudio`,
      name: site.name,
      description: 'Productora audiovisual creativa en Sevilla: dirección creativa y producción audiovisual para marcas, artistas y creadores.',
      url: home,
      logo: new URL('/brand/logo-apilado-negro.svg', Astro.site).toString(),
      image: imageUrl,
      email: site.email,
      telephone: phone,
      address: { '@type': 'PostalAddress', addressLocality: 'Sevilla', addressRegion: 'Andalucía', addressCountry: 'ES' },
      geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng },
      areaServed: { '@type': 'Country', name: 'España' },
      founder: { '@type': 'Person', name: 'Jesús Font', jobTitle: 'Director creativo y fundador' },
      sameAs: [site.instagram],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#web`,
      url: home,
      name: site.name,
      inLanguage: 'es',
      publisher: { '@id': `${home}#estudio` },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F2EDE4" />
    <link
      rel="preload"
      href="/fonts/league-spartan-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/archivo-latin-standard-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- La cursiva va en el H1 de todas las páginas: si llega tarde, el titular cambia de alto -->
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-wght-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Miniaturas de los vídeos: se abre la conexión con YouTube de antemano -->
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="icon" href="/brand/isotipo-negro.svg" type="image/svg+xml" />

    <!-- Compartir -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nanai Studio: rodaje con luz roja" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />
  </body>
</html>
