---
/**
 * Inicio · Hero. Copy centrado y arriba; dos botones de deslizar del mismo peso.
 * Cruceta de visor que sigue al puntero (solo ratón y sin movimiento reducido).
 * La imagen es una foto de rodaje del estudio (24-09), sin retoque de IA.
 */
import { Picture } from 'astro:assets';
import heroImage from '../../assets/media/hero-rodaje.jpg';
import FrameMarks from '../ui/FrameMarks.astro';
import SlideCta from './SlideCta.astro';
import { brand } from '../../data/copy';
import { site } from '../../data/site';
---

<section class="home-hero zone-night" aria-label="Presentación" data-hero>
  <Picture
    src={heroImage}
    formats={['avif', 'webp']}
    widths={[640, 1024, 1600, 1920]}
    sizes="100vw"
    alt=""
    class="home-hero__image"
    loading="eager"
    fetchpriority="high"
  />
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <FrameMarks />

  <div class="home-hero__reticle" aria-hidden="true" data-reticle>
    <span class="home-hero__cross"></span>
    <span class="label home-hero__readout" data-readout></span>
  </div>

  <div class="container home-hero__body">
    <div class="home-hero__masthead">
      <p class="label home-hero__eyebrow">{brand.eyebrow}</p>
      <h1 class="headline home-hero__title">
        <span>{brand.claim[0]}</span>
        <span class="tone-2">{brand.claim[1]}</span>
      </h1>
    </div>
    <p class="home-hero__deck">{brand.deck}</p>

    <div class="home-hero__actions">
      <SlideCta href="#trabajo" label="Ver trabajos" />
      <SlideCta href="#contacto" label="Hablemos" />
    </div>
  </div>

  <div class="container label home-hero__hud">
    <span>{site.coordinates}</span>
    <span>Rodaje — Nanai Studio</span>
    <span data-timecode aria-hidden="true">TC 00:00:12:08</span>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Timecode a 24 fps; se congela con movimiento reducido.
  // Si la apertura empezó a grabar (data-rec-start), sigue contando desde ese momento.
  const timecode = document.querySelector<HTMLElement>('[data-timecode]');
  if (timecode && !reduceMotion) {
    const pad = (n: number) => String(n).padStart(2, '0');
    let frame = 12 * 24 + 8;
    window.setInterval(() => {
      if (document.hidden) return;
      const recStart = Number(document.documentElement.dataset.recStart);
      frame = recStart ? Math.floor((performance.now() - recStart) / (1000 / 24)) : frame + 1;
      const f = frame % 24;
      const s = Math.floor(frame / 24) % 60;
      const m = Math.floor(frame / (24 * 60)) % 60;
      const h = Math.floor(frame / (24 * 3600));
      timecode.textContent = `TC ${pad(h)}:${pad(m)}:${pad(s)}:${pad(f)}`;
    }, 1000 / 24);
  }

  // Cruceta de visor: sigue al ratón con un poco de inercia y se oculta sobre los botones.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reticle = document.querySelector<HTMLElement>('[data-reticle]');
  const readout = document.querySelector<HTMLElement>('[data-readout]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (hero && reticle && readout && finePointer && !reduceMotion) {
    const pad4 = (n: number) => String(Math.max(0, Math.round(n))).padStart(4, '0');
    let x = 0;
    let y = 0;
    let targetX = 0;
    let targetY = 0;
    let frame = 0;

    const follow = () => {
      x += (targetX - x) * 0.2;
      y += (targetY - y) * 0.2;
      reticle.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      frame = Math.abs(targetX - x) + Math.abs(targetY - y) > 0.5 ? requestAnimationFrame(follow) : 0;
    };

    hero.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const box = hero.getBoundingClientRect();
      targetX = event.clientX - box.left;
      targetY = event.clientY - box.top;

      if (!hero.classList.contains('has-reticle')) {
        x = targetX;
        y = targetY;
      }

      const overControl = (event.target as Element).closest('a, button') !== null;
      hero.classList.toggle('has-reticle', !overControl);
      readout.textContent = `X ${pad4(targetX)} · Y ${pad4(targetY)}`;
      if (!frame) frame = requestAnimationFrame(follow);
    });

    hero.addEventListener('pointerleave', () => hero.classList.remove('has-reticle'));
  }
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
  }

  .home-hero :global(img.home-hero__image) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  /* En vertical el recorte es muy estrecho: se encuadra en la cámara y el operador */
  @media (max-width: 767px) {
    .home-hero :global(img.home-hero__image) { object-position: 68% 50%; }
  }

  /* Velo centrado detrás del copy + fundido abajo para la línea de monitor */
  .home-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 75% 60% at 50% 32%, var(--scrim-deep) 0%, var(--scrim-deep) 35%, transparent 100%),
      linear-gradient(to top, var(--scrim-strong) 0%, transparent 40%);
  }

  .home-hero__reticle {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-switch) var(--ease-standard);
  }

  .home-hero.has-reticle .home-hero__reticle { opacity: 1; }

  .home-hero__cross {
    position: absolute;
    top: calc(var(--frame-mark) / -2);
    left: calc(var(--frame-mark) / -2);
    width: var(--frame-mark);
    height: var(--frame-mark);
  }

  .home-hero__cross::before,
  .home-hero__cross::after {
    content: '';
    position: absolute;
    background: var(--bone);
  }

  .home-hero__cross::before {
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--hairline);
  }

  .home-hero__cross::after {
    top: 50%;
    left: 0;
    right: 0;
    height: var(--hairline);
  }

  .home-hero__readout {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    color: var(--text-on-ink);
    white-space: nowrap;
  }

  .home-hero__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--hero-top);
    text-align: center;
  }

  /* Cabecera de portada: el claim a sangre de contenedor, sin filetes */
  .home-hero__masthead { width: 100%; }

  .home-hero__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--text-on-ink);
  }

  .home-hero__title {
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--tracking-hero);
  }

  .home-hero__title span { display: block; }

  .home-hero__deck {
    max-width: var(--measure-deck);
    margin-top: var(--space-4);
    font-size: var(--fs-deck);
    line-height: var(--lh-statement);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-6);
  }

  .home-hero__hud {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin-top: auto;
    padding-block: var(--space-2) var(--space-6);
    border-top: var(--hairline) solid var(--hud-rule);
  }

  /* Dos botones de 216px no caben en línea: se apilan con el mismo ancho */
  @media (max-width: 479px) {
    .home-hero__actions {
      flex-direction: column;
      align-items: center;
    }

    .home-hero__hud { margin-top: var(--space-12); }
  }
</style>
